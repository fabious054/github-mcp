# ---------------------------------------------------------------------------
# OPÇÃO 1 — OAuth do GitHub (recomendado: qualquer pessoa conecta a própria
# conta, sem gerar token manualmente)
# ---------------------------------------------------------------------------
# Client ID/Secret de um GitHub OAuth App (github.com → Settings → Developer
# settings → OAuth Apps → New OAuth App). Authorization callback URL deve ser:
# https://<seu-projeto>.vercel.app/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Chave usada para assinar/criptografar o fluxo de OAuth (não há banco de
# dados — tudo viaja criptografado nos próprios parâmetros). Gere com:
#   openssl rand -base64 32
OAUTH_ENCRYPTION_KEY=

# Opcional: escopos pedidos ao usuário no GitHub (padrão: "repo read:org")
GITHUB_OAUTH_SCOPES=

# Opcional: se este MCP for sempre sobre o mesmo repositório (e só a
# identidade de quem chama varia), fixe owner/repo padrão:
DEFAULT_OWNER=
DEFAULT_REPO=

# ---------------------------------------------------------------------------
# OPÇÃO 2 — conta única fixa (modo legado, sem OAuth)
# ---------------------------------------------------------------------------
# Só é usada se GITHUB_OAUTH_CLIENT_ID não estiver definido.
GITHUB_TOKEN=
# DEFAULT_OWNER / DEFAULT_REPO acima também se aplicam aqui.

# ---------------------------------------------------------------------------
# OPÇÃO 3 — múltiplas contas fixas (modo legado, sem OAuth)
# ---------------------------------------------------------------------------
# Também só é usada se GITHUB_OAUTH_CLIENT_ID não estiver definido, e tem
# prioridade sobre GITHUB_TOKEN.
# GITHUB_ACCOUNTS={"pessoal":{"token":"ghp_xxx","defaultOwner":"fabio-gh","defaultRepo":"meu-repo"},"robozz":{"token":"ghp_yyy","defaultOwner":"robozz-br","defaultRepo":"rbz-api-pricebot","owners":["robozz-br"]}}
GITHUB_ACCOUNTS=
DEFAULT_ACCOUNT=
