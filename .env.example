# ---------------------------------------------------------------------------
# OPTION 1 — GitHub OAuth (recommended: anyone connects their own account,
# no manual token generation)
# ---------------------------------------------------------------------------
# Client ID/Secret of a GitHub OAuth App (github.com → Settings → Developer
# settings → OAuth Apps → New OAuth App). Authorization callback URL must be:
# https://<your-project>.vercel.app/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Key used to sign/encrypt the OAuth flow (there is no database — everything
# travels encrypted inside the parameters themselves). Generate with:
#   openssl rand -base64 32
OAUTH_ENCRYPTION_KEY=

# Optional: scopes requested from the user on GitHub (default: "repo read:org")
GITHUB_OAUTH_SCOPES=

# Optional: if this MCP is always about the same repository (only the
# caller's identity varies), fix a default owner/repo:
DEFAULT_OWNER=
DEFAULT_REPO=

# ---------------------------------------------------------------------------
# OPTION 2 — single fixed account (legacy mode, no OAuth)
# ---------------------------------------------------------------------------
# Only used if GITHUB_OAUTH_CLIENT_ID is not set.
GITHUB_TOKEN=
# DEFAULT_OWNER / DEFAULT_REPO above also apply here.

# ---------------------------------------------------------------------------
# OPTION 3 — multiple fixed accounts (legacy mode, no OAuth)
# ---------------------------------------------------------------------------
# Also only used if GITHUB_OAUTH_CLIENT_ID is not set, and takes priority
# over GITHUB_TOKEN.
# GITHUB_ACCOUNTS={"personal":{"token":"ghp_xxx","defaultOwner":"your-gh-user","defaultRepo":"your-repo"},"work":{"token":"ghp_yyy","defaultOwner":"your-org","defaultRepo":"your-org-repo","owners":["your-org"]}}
GITHUB_ACCOUNTS=
DEFAULT_ACCOUNT=

# ---------------------------------------------------------------------------
# Multi-account linking (used only in OAuth mode, see 'link_account' tool)
# ---------------------------------------------------------------------------
# MongoDB Atlas connection string — required to link more than one GitHub
# account to the same primary identity (ADR 0002).
MONGODB_URI=

# Optional: this server's public origin, used to build the link the
# 'link_account' tool returns. If unset, falls back to the URL Vercel sets
# automatically on deploy.
PUBLIC_ORIGIN=
